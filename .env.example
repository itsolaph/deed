# Copy to .env (git-ignored). The testnet scripts (demo-testnet, hostile-seller, wash-reject)
# read it; variables already set in the shell win. Only settings here, never keys: keys stay in
# the near-cli legacy keychain (~/.near-credentials/testnet/<account>.json).

# RPC endpoints, comma separated (default: FastNEAR testnet, then rpc.testnet.near.org).
# NEAR_RPC_URLS=https://test.rpc.fastnear.com,https://rpc.testnet.near.org

# Transaction index used for earnings history and the buyer's revenue appraisal.
# DEED_TX_INDEX=https://tx.test.fastnear.com

# Accounts (default: deployments/testnet.json). The seller needs about 3.5 NEAR per run (a mint
# costs 2.88 NEAR); create a fresh one with the faucet:
#   near account create-account sponsor-by-faucet-service <name>.testnet autogenerate-new-keypair save-to-legacy-keychain network-config testnet create
# DEMO_SELLER=your-seller.testnet
# DEMO_BUYER=your-buyer.testnet
# DEMO_ALICE=your-alice.testnet
# DEMO_BOB=your-bob.testnet

# scripts/demo-testnet.sh
# DEMO_SLUG=relay-mytest
# DEMO_PORT_A=7601
# DEMO_PORT_B=7602
# DEMO_ECHO_PORT=7611
# DEMO_TRAFFIC_SEC=75
# DEMO_AFTER_SEC=45

# scripts/hostile-seller.sh (defaults to DEMO_SELLER)
# HOSTILE_SELLER=your-other-seller.testnet
# HOSTILE_SLUG=hostile-mytest
# HOSTILE_PORT_A=7606
# HOSTILE_PORT_B=7607
# HOSTILE_ECHO_PORT=7614

# scripts/wash-reject.mjs (defaults to DEMO_SELLER)
# WASH_SELLER=your-third-seller.testnet
# WASH_SLUG=wash-mytest
# WASH_PORT=7605
# WASH_ECHO_PORT=7613

# Where the legacy keychain lives (default ~/.near-credentials).
# NEAR_CREDENTIALS_DIR=
